# ============================================================
# OpenCliWeb 环境变量 / OpenCliWeb environment variables
# 复制为 .env 后按实际情况修改 / Copy this file to .env and edit
# ============================================================

# 必填 / Required
STORAGE_SECRET=xxxxxx                       # 任意的固定字符串 / Any fixed random string

# 必填 / Required —— 任意 OpenAI 兼容端点，在线或本地均可
# Any OpenAI-compatible endpoint, hosted or local
LLM_API_BASE=https://api.openai.com/v1      # API 地址 / API base URL
LLM_API_KEY=sk-xxxxx                        # 密钥 / API key
LLM_MODEL=gpt-4.1-mini                      # 模型名称，需支持 function calling / Model name, must support function calling

# 建议填写 / Recommended —— 留空则无法登录 WebUI / Leave unset and the WebUI cannot be logged into
WEBUI_USERNAME=janedoe                      # WebUI 用户名 / WebUI username
WEBUI_PASSWORD=123456                       # WebUI 密码 / WebUI password

# 可选 / Optional
HOST=127.0.0.1                              # WebUI 主机地址，127.0.0.1 仅本机可访问 / WebUI host address, 127.0.0.1 is localhost-only
PORT=7860                                   # WebUI 端口 / WebUI port

LANGUAGE=简体中文                            # 回答所使用的语言，英文请填 English / Language used for answers, use English for English output
